# Copy to keystore.properties in the repository root; that file is ignored.
# Use forward slashes and an absolute path. Never commit real passwords.
storeFile=C:/Users/YOUR_USERNAME/umihi-keypad-release.jks
storePassword=REPLACE_WITH_YOUR_STORE_PASSWORD
keyAlias=umihi-keypad
keyPassword=REPLACE_WITH_YOUR_KEY_PASSWORD
